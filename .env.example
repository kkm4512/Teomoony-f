# Teomoony-f 설정 — 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올리지 않습니다)
# ..\Teomoony\.env (Teomoony-b) 가 있으면 자동으로 함께 읽습니다. 이 폴더의 .env 가 우선.

PORT=5173

# SQL Server (필수)
DB_HOST=127.0.0.1
DB_PORT=11433
DB_USER=sa
DB_PASSWORD=
DB_NAME=Teomoony

# VWorld — 배경지도 타일 · 지오코딩 (없으면 OpenStreetMap)
VWORLD_KEY=
VWORLD_DOMAIN=localhost
# VWorld 국가중점데이터(NED)
VWORLD_NED_KEY=

# 로그인 — 비면 로그인 기능이 열리지 않습니다. node tools/auth_init.js 로 생성
AUTH_SECRET=
ROOT_PASSWORD=

# AI 검색 — 없으면 AI 검색만 꺼집니다
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
